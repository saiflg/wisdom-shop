# Production environment for the whole stack — the shop and Wisdom Campus.
#
#   cp .env.production.example .env
#
# Then replace EVERY value marked CHANGE ME. Nothing here is a working default;
# the placeholders are deliberately invalid so a half-configured deploy fails
# at startup rather than running with a guessable secret.
#
# Generate each secret separately. Reusing one value across two variables means
# a token minted by one service is structurally valid on another:
#
#   openssl rand -base64 48
#
# This file contains every secret the deployment has. It must never be
# committed — .gitignore already covers .env — and on the server it should be
# `chmod 600`, which deploy.sh checks.

# ---------------------------------------------------------------------------
# Domains. These must already resolve to this machine before you start the
# stack: Caddy proves control of each name over HTTP, and a name that does not
# point here yet fails and counts against a Let's Encrypt rate limit.
# ---------------------------------------------------------------------------
SHOP_DOMAIN=shop.example.com
CAMPUS_DOMAIN=campus.example.com
ADMIN_DOMAIN=admin.example.com

# Where Let's Encrypt sends expiry warnings if renewal ever stops working.
# A real mailbox somebody reads.
ACME_EMAIL=you@example.com

# Must match SHOP_DOMAIN above. The shop's API reads this for absolute links
# in outgoing email; compose derives the browser bundle's copy from
# SHOP_DOMAIN, so a mismatch here shows up only in emailed links.
APP_URL=https://shop.example.com

# ---------------------------------------------------------------------------
# Postgres. One server, several databases: the shop's, the ERP's control
# database, and one per school created at onboarding time.
# ---------------------------------------------------------------------------
POSTGRES_USER=wisdom
POSTGRES_PASSWORD=CHANGE_ME_postgres_password
POSTGRES_DB=wisdom_shop
EMS_CONTROL_DB=wisdom_ems_control

REDIS_PASSWORD=CHANGE_ME_redis_password
MEILI_MASTER_KEY=CHANGE_ME_meilisearch_master_key

# ---------------------------------------------------------------------------
# The shop's own secrets.
# ---------------------------------------------------------------------------
JWT_ACCESS_SECRET=CHANGE_ME_at_least_32_characters_long_secret
JWT_REFRESH_SECRET=CHANGE_ME_a_DIFFERENT_32_plus_character_secret

# ---------------------------------------------------------------------------
# Wisdom Campus secrets.
#
# Deliberately not named JWT_ACCESS_SECRET/JWT_REFRESH_SECRET: this .env is
# loaded into every service, so reusing the shop's names would hand both apps
# the identical key and a school token would be structurally valid on the shop.
# ---------------------------------------------------------------------------
EMS_JWT_ACCESS_SECRET=CHANGE_ME_at_least_32_characters_long_secret
EMS_JWT_REFRESH_SECRET=CHANGE_ME_a_DIFFERENT_32_plus_character_secret
PLATFORM_JWT_ACCESS_SECRET=CHANGE_ME_a_DIFFERENT_32_plus_character_secret
PLATFORM_JWT_REFRESH_SECRET=CHANGE_ME_a_DIFFERENT_32_plus_character_secret

# Encrypts each school's stored gateway credentials (SMTP passwords, payment
# provider secrets) at rest.
#
# BACK THIS UP, AND NEVER CHANGE IT CASUALLY. Rotating it does not re-encrypt
# anything: every stored secret becomes undecryptable, every school's settings
# page reports its gateways as unconfigured, and each school must re-enter
# credentials it may no longer have.
EMS_SETTINGS_ENCRYPTION_KEY=CHANGE_ME_at_least_32_characters_long_secret

# The one value that must be IDENTICAL in both apps. The shop mints a handoff
# token when somebody buys the ERP; the ERP verifies it by computing the same
# HMAC. Different values here means every purchase lands on a broken setup
# link.
EDU_SETUP_SIGNING_SECRET=CHANGE_ME_at_least_32_characters_long_secret

# Subdomain routing per school (st-marys.campus.example.com). Leave EMPTY.
# Turning it on requires certificates for hostnames that do not exist yet —
# see the note at the bottom of deploy/caddy/Caddyfile. Empty means schools
# choose their school on the login form, which works today.
EMS_BASE_DOMAIN=

# ---------------------------------------------------------------------------
# The first platform operator, created by the ems-migrate container.
#
# Set these for the FIRST deploy, sign in, then REMOVE the password line and
# redeploy. The seed only ever creates — it will not reset the password of an
# operator who already exists — but a live password sitting in a file on disk
# is worth deleting once it has done its job.
# ---------------------------------------------------------------------------
SEED_PLATFORM_ADMIN_EMAIL=you@example.com
SEED_PLATFORM_ADMIN_PASSWORD=CHANGE_ME_at_least_12_characters

# ---------------------------------------------------------------------------
# Recurring billing. Off by default: an accidental cycle charges real
# customers real money, so switching it on has to be a deliberate act.
# ---------------------------------------------------------------------------
BILLING_CYCLE_ENABLED=false

# ---------------------------------------------------------------------------
# No AI provider key here, on purpose.
#
# The provider and its API key are chosen by the Super Admin in the console at
# https://ADMIN_DOMAIN and stored encrypted in the control database. An
# environment variable would mean one hardcoded vendor and a redeploy to
# change it — and a key in a file that gets copied around.
# ---------------------------------------------------------------------------
