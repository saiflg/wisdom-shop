{
  "name": "wisdom-shop",
  "version": "0.1.0",
  "private": true,
  "description": "Wisdom Shop — Everything Educational in One Place",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "pnpm --parallel -r run dev",
    "dev:web": "pnpm --filter @wisdom-shop/web run dev",
    "dev:api": "pnpm --filter @wisdom-shop/api run dev",
    "dev:ems": "pnpm --filter @wisdom-shop/ems run dev",
    "build": "pnpm -r run build",
    "lint": "pnpm -r run lint",
    "test": "pnpm -r run test",
    "typecheck": "pnpm -r run typecheck",
    "format": "prettier --write \"apps/**/*.{ts,tsx,js,json,css,md}\"",
    "prepare": "husky || true"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "typescript": "^5.6.2"
  }
}
