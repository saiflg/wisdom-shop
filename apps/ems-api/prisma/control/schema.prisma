// Control-plane schema: the School registry and platform operators.
// Conventions match apps/api/prisma/schema.prisma: cuid() PKs, createdAt/
// updatedAt on every table, @@map to snake_case. This schema is applied to
// exactly one database (CONTROL_DATABASE_URL) — never to a school's own.

generator client {
  provider = "prisma-client-js"
  // Under node_modules, not src/generated: `tsc` only copies files it
  // compiles from src into dist, so a plain-JS client under src/generated
  // would exist at dev time (ts-node/nest watch) but be missing from the
  // compiled dist/ output entirely. node_modules resolves the same way
  // regardless of how deep the requiring file sits under src or dist.
  output = "../../node_modules/ems-control-client"
}

datasource db {
  provider = "postgresql"
  url      = env("CONTROL_DATABASE_URL")
}

enum SchoolStatus {
  PROVISIONING
  ACTIVE
  SUSPENDED
  FAILED
}

enum PlatformRoleName {
  PLATFORM_ADMIN
  PLATFORM_SUPPORT
}

model School {
  id           String       @id @default(cuid())
  name         String
  /// Used both as the onboarding-time database-name seed and as the
  /// explicit tenant selector at school-user login (no subdomain routing
  /// yet — see PROGRESS.md).
  slug         String       @unique
  databaseName String       @unique
  status       SchoolStatus @default(PROVISIONING)
  /// Set only for schools created via the shop's "Complete Your School
  /// Setup" handoff — the license key that activated it. @unique so the
  /// same license can never provision a second school; the onboarding
  /// endpoint treats a repeat with the same key as "already done", not an
  /// error. Null for schools a platform admin created directly.
  licenseKey   String?      @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  provisioningAttempts ProvisioningAttempt[]
  lifecycleEvents      SchoolLifecycleEvent[]
  subscription         Subscription?
  invoices             Invoice[]

  @@index([status])
  @@map("schools")
}

/// Audit trail for operator-driven status changes (suspend/reactivate).
/// Separate from ProvisioningAttempt, which records what the automated
/// onboarding pipeline did — this records what a human decided and why.
/// The first piece of the platform-wide audit log.
model SchoolLifecycleEvent {
  id       String @id @default(cuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  fromStatus SchoolStatus
  toStatus   SchoolStatus
  /// Why the operator did it. Required for suspension in particular: "this
  /// school is locked out" is useless to whoever picks it up next without it.
  reason     String

  /// Deliberately NOT a foreign key to PlatformUser: this record has to
  /// outlive the operator's account. Deleting a departed admin must not
  /// cascade away the history of the suspensions they issued.
  actorPlatformUserId String
  actorEmail          String

  createdAt DateTime @default(now())

  @@index([schoolId])
  @@map("school_lifecycle_events")
}

/// Forensic trail for onboarding: the concrete answer to "what happened
/// when provisioning failed partway", queryable without grepping logs.
model ProvisioningAttempt {
  id           String   @id @default(cuid())
  schoolId     String
  school       School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  /// "create_database" | "migrate_deploy" | "seed_admin"
  step         String
  success      Boolean
  errorMessage String?

  createdAt DateTime @default(now())

  @@index([schoolId])
  @@map("provisioning_attempts")
}

model PlatformUser {
  id           String             @id @default(cuid())
  email        String             @unique
  passwordHash String
  firstName    String
  lastName     String
  roles        PlatformRoleName[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  refreshTokens PlatformRefreshToken[]

  @@map("platform_users")
}

model PlatformRefreshToken {
  id             String       @id @default(cuid())
  platformUserId String
  platformUser   PlatformUser @relation(fields: [platformUserId], references: [id], onDelete: Cascade)
  tokenHash      String       @unique
  expiresAt      DateTime
  revokedAt      DateTime?
  userAgent      String?
  ipAddress      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([platformUserId])
  @@map("platform_refresh_tokens")
}

// ── Subscriptions and billing ────────────────────────────────────────
// All monetary amounts are integer minor units (kobo/cents) named
// *Cents, matching apps/api/prisma/schema.prisma. Never floats: 0.1 + 0.2
// is not 0.3 in IEEE-754, and money that fails to add up is not a
// rounding curiosity, it is a wrong invoice.

enum BillingInterval {
  MONTHLY
  YEARLY
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
}

enum InvoiceStatus {
  DRAFT
  OPEN
  PAID
  VOID
  UNCOLLECTIBLE
}

/// Who raised the invoice. This is what the double-billing guard keys on:
/// the automated cycle may produce at most one invoice per subscription
/// period, but an operator can raise as many ad-hoc invoices as a school
/// genuinely needs (extra seats mid-period, a one-off charge).
enum InvoiceOrigin {
  CYCLE
  MANUAL
}

/// The sellable catalogue. Retired plans keep `isActive = false` rather
/// than being deleted, because subscriptions and issued invoices still
/// reference them and history must stay readable.
model SubscriptionPlan {
  id         String          @id @default(cuid())
  code       String          @unique
  name       String
  priceCents Int
  currency   String          @default("NGN")
  interval   BillingInterval
  /// null means unlimited, which is different from 0.
  maxStudents Int?
  maxStaff    Int?
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscriptions Subscription[]

  @@map("subscription_plans")
}

model Subscription {
  id       String @id @default(cuid())
  schoolId String @unique
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  planId   String
  plan     SubscriptionPlan @relation(fields: [planId], references: [id])

  status SubscriptionStatus @default(TRIALING)

  /// Price snapshotted at subscribe time. Repricing a plan must never
  /// silently change what an existing customer pays — the same reason the
  /// shop snapshots unit prices onto order lines.
  priceCents Int
  currency   String
  interval   BillingInterval

  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  trialEndsAt        DateTime?
  /// Cancellation is deferred by default: access continues to the end of
  /// the paid period rather than being cut off the moment someone clicks.
  cancelAtPeriodEnd  Boolean   @default(false)
  canceledAt         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invoices Invoice[]

  @@index([status])
  @@map("subscriptions")
}

model Invoice {
  /// Human-facing sequential identifier (INV-000001). Unique because a
  /// duplicate or missing invoice number is an accounting problem, not a
  /// display bug.
  number String @id

  schoolId       String
  school         School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  subscriptionId String?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  status   InvoiceStatus @default(DRAFT)
  origin   InvoiceOrigin @default(MANUAL)
  currency String

  /// Denormalised from the lines, and asserted to match them in tests.
  subtotalCents Int
  totalCents    Int

  periodStart DateTime
  periodEnd   DateTime
  issuedAt    DateTime?
  dueAt       DateTime?
  paidAt      DateTime?
  voidedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lines InvoiceLine[]

  /// The double-billing guard is a PARTIAL unique index on
  /// (subscriptionId, periodStart) WHERE origin = 'CYCLE'. Prisma's schema
  /// DSL cannot express a partial index, so it lives in the migration SQL
  /// only — see 20260803153000_cycle_invoices_unique_per_period. Prisma
  /// still surfaces the violation as P2002, which runBillingCycle catches.
  ///
  /// It is deliberately not a plain @@unique: that also blocked an
  /// operator raising a legitimate second ad-hoc invoice inside the same
  /// period, which the full e2e run caught.
  @@index([schoolId])
  @@index([status])
  @@map("invoices")
}

model InvoiceLine {
  id            String  @id @default(cuid())
  invoiceNumber String
  invoice       Invoice @relation(fields: [invoiceNumber], references: [number], onDelete: Cascade)

  description    String
  quantity       Int
  unitPriceCents Int
  /// Always quantity * unitPriceCents; stored so a historic line stays
  /// readable even if the arithmetic rules ever change.
  amountCents    Int

  createdAt DateTime @default(now())

  @@index([invoiceNumber])
  @@map("invoice_lines")
}

/// Single-row table backing sequential invoice numbering. A counter row
/// updated inside the same transaction as the insert is what makes two
/// concurrent invoice generations impossible to collide — see
/// BillingService.generateInvoice.
model InvoiceCounter {
  id       Int @id @default(1)
  lastUsed Int @default(0)

  @@map("invoice_counter")
}
