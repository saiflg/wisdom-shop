// Tenant schema: applied to EVERY school's own database
// (wisdom_ems_school_<slug>) via `prisma migrate deploy` at onboarding
// time — see ProvisioningService. Never applied to the control database.
//
// DATABASE_URL here is only read directly by the Prisma CLI when running
// migrations (`prisma migrate dev/deploy --schema=prisma/tenant/schema.prisma`
// against a specific school's connection string). At runtime the app never
// reads it directly — TenancyService builds each school's own connection
// string and hands it to a PrismaClient constructed with an explicit
// `datasources` override. See tenancy/connection-string.ts.

generator client {
  provider = "prisma-client-js"
  // See prisma/control/schema.prisma for why this is under node_modules
  // rather than src/generated.
  output = "../../node_modules/ems-tenant-client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleName {
  SCHOOL_ADMIN
  TEACHER
  STUDENT
  GUARDIAN
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  WITHDRAWN
}

model User {
  id           String  @id @default(cuid())
  /// Unique but nullable: Postgres treats NULLs as distinct in a unique
  /// index, so any number of email-less student Users can coexist. A
  /// student without portal access has both email and passwordHash null;
  /// enforced at the service layer (staff-role Users must have both), not
  /// as a DB constraint — a CHECK across a role array is awkward in
  /// Postgres and the invariant reads better as code (see role-policy.ts
  /// in apps/api/src/users for the pattern this follows).
  email        String? @unique
  passwordHash String?
  firstName    String
  lastName     String
  roles        RoleName[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  refreshTokens        RefreshToken[]
  studentProfile       StudentProfile?
  guardianLinks        GuardianLink[]
  homeroomFor          Class[]        @relation("HomeroomTeacher")
  createdSchemesOfWork SchemeOfWork[]
  createdLessonPlans   LessonPlan[]

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  ipAddress String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("refresh_tokens")
}

model Class {
  id                String  @id @default(cuid())
  name              String
  gradeLevel        String?
  /// Plain string for this phase (e.g. "2026-2027") — a full AcademicYear/
  /// Term entity is a later-phase concern once curriculum scheduling needs it.
  academicYear      String
  homeroomTeacherId String?
  homeroomTeacher   User?   @relation("HomeroomTeacher", fields: [homeroomTeacherId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  enrollments Enrollment[]

  @@index([academicYear])
  @@map("classes")
}

model StudentProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// School-issued admission/roll number — optional since not every school
  /// assigns one at creation time.
  studentCode String?   @unique
  dateOfBirth DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  enrollments   Enrollment[]
  guardianLinks GuardianLink[]

  @@map("student_profiles")
}

model Enrollment {
  id               String           @id @default(cuid())
  studentProfileId String
  studentProfile   StudentProfile   @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  classId          String
  class            Class            @relation(fields: [classId], references: [id], onDelete: Cascade)
  status           EnrollmentStatus @default(ACTIVE)
  startDate        DateTime         @default(now())
  endDate          DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Deliberately NOT a compound @@unique on (studentProfileId, classId): a
  /// student can withdraw and re-enrol later. Prisma's schema DSL has no
  /// partial-unique-index support to express "unique only while ACTIVE", so
  /// EnrollmentsService enforces "no second ACTIVE row for the same pair" at
  /// the service layer instead.
  @@index([studentProfileId])
  @@index([classId])
  @@map("enrollments")
}

model GuardianLink {
  id               String         @id @default(cuid())
  guardianUserId   String
  guardianUser     User           @relation(fields: [guardianUserId], references: [id], onDelete: Cascade)
  studentProfileId String
  studentProfile   StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  /// Free text ("Mother", "Legal Guardian", …) — an enum would just churn.
  relationship     String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([guardianUserId, studentProfileId])
  @@index([studentProfileId])
  @@map("guardian_links")
}

// ── AI Curriculum Engine — Phase 1: settings, subjects, schemes of work ──
// See PROGRESS.md for the phased scope: lesson plans, quizzes, exams,
// worksheets, and exports all follow this same shape in later phases.

enum CurriculumMode {
  MANUAL
  AI_AUTOMATIC
  HYBRID
}

/// Real singleton, one row per school — seeded at provisioning time
/// (ProvisioningService.seedSchoolAdmin), never lazily created. Mode gates
/// only whether the AI-generate endpoint is offered; manual create/edit is
/// always available regardless of mode (see PROGRESS.md for why).
model CurriculumSettings {
  id                 String         @id @default(cuid())
  mode               CurriculumMode @default(MANUAL)
  /// Free text fed straight into the AI prompt (e.g. "Nigeria", "United
  /// States") — relying on the model's own knowledge of that country's
  /// standards rather than a maintained standards database, which is its
  /// own later-phase concern if it's ever needed.
  country            String?
  curriculumStandard String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("curriculum_settings")
}

model Subject {
  id         String  @id @default(cuid())
  name       String
  /// Free text, same convention as Class.gradeLevel.
  gradeLevel String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  schemesOfWork SchemeOfWork[]

  @@unique([name, gradeLevel])
  @@map("subjects")
}

enum SchemeOfWorkStatus {
  DRAFT
  PUBLISHED
}

enum ContentSource {
  MANUAL
  AI_GENERATED
}

model SchemeOfWork {
  id           String             @id @default(cuid())
  subjectId    String
  subject      Subject            @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  academicYear String
  /// Free text ("Term 1", "Semester 1"...) — schools vary in how they divide the year.
  term         String
  status       SchemeOfWorkStatus @default(DRAFT)
  source       ContentSource
  /// `{ weeks: [{ weekNumber, topic, objectives: string[], activities: string[] }] }`
  /// — the same shape whether hand-written or AI-generated; validated at
  /// the service layer against the Gemini responseSchema, not a DB constraint.
  content      Json
  generatedAt  DateTime?
  createdById  String?
  createdBy    User?              @relation(fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lessonPlans LessonPlan[]

  @@unique([subjectId, academicYear, term])
  @@map("schemes_of_work")
}

// ── AI Curriculum Engine — Phase 4: lesson plans ──
// Repeats the exact same shape as schemes of work: mode-gated AI generate,
// manual create/edit/publish always available, PUBLISHED-only read scoping
// for STUDENT/GUARDIAN. See PROGRESS.md.

enum LessonPlanStatus {
  DRAFT
  PUBLISHED
}

model LessonPlan {
  id             String           @id @default(cuid())
  schemeOfWorkId String
  schemeOfWork   SchemeOfWork     @relation(fields: [schemeOfWorkId], references: [id], onDelete: Cascade)
  /// Which week of the parent scheme of work this lesson plan expands into
  /// a full daily lesson — one lesson plan per week, same "one week = one
  /// lesson" simplification SchemeOfWork.content itself already makes.
  weekNumber     Int
  status         LessonPlanStatus @default(DRAFT)
  source         ContentSource
  /// `{ objectives: string[], materials: string[], introduction: string,
  /// developmentSteps: string[], conclusion: string, assessment: string,
  /// homework: string }` — built from the parent week's topic/objectives/
  /// activities when generated, editable afterward same as schemes of work.
  content     Json
  generatedAt DateTime?
  createdById String?
  createdBy   User?     @relation(fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([schemeOfWorkId, weekNumber])
  @@map("lesson_plans")
}
