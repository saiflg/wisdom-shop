// Tenant schema: applied to EVERY school's own database
// (wisdom_ems_school_<slug>) via `prisma migrate deploy` at onboarding
// time — see ProvisioningService. Never applied to the control database.
//
// DATABASE_URL here is only read directly by the Prisma CLI when running
// migrations (`prisma migrate dev/deploy --schema=prisma/tenant/schema.prisma`
// against a specific school's connection string). At runtime the app never
// reads it directly — TenancyService builds each school's own connection
// string and hands it to a PrismaClient constructed with an explicit
// `datasources` override. See tenancy/connection-string.ts.

generator client {
  provider = "prisma-client-js"
  // See prisma/control/schema.prisma for why this is under node_modules
  // rather than src/generated.
  output = "../../node_modules/ems-tenant-client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleName {
  SCHOOL_ADMIN
  TEACHER
  STUDENT
  GUARDIAN
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  WITHDRAWN
}

model User {
  id           String  @id @default(cuid())
  /// Unique but nullable: Postgres treats NULLs as distinct in a unique
  /// index, so any number of email-less student Users can coexist. A
  /// student without portal access has both email and passwordHash null;
  /// enforced at the service layer (staff-role Users must have both), not
  /// as a DB constraint — a CHECK across a role array is awkward in
  /// Postgres and the invariant reads better as code (see role-policy.ts
  /// in apps/api/src/users for the pattern this follows).
  email        String? @unique
  passwordHash String?
  firstName    String
  lastName     String
  /// When this person was last active, for the "online now" dot in a class
  /// chat.
  ///
  /// Deliberately coarse. It is written when somebody opens a conversation,
  /// not on every keystroke or every request: the question a child is asking
  /// is "is anybody there", and answering it to the minute is enough. A
  /// precise activity log of children would be surveillance, and this is a
  /// presence indicator.
  lastSeenAt   DateTime?

  /// Free text and deliberately not unique — two parents legitimately share
  /// a number, and a household landline is one address for a whole family.
  /// Normalisation to E.164 is left to whatever the school's SMS vendor
  /// accepts rather than guessed at here.
  phone        String?
  roles        RoleName[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  refreshTokens        RefreshToken[]
  studentProfile       StudentProfile?
  guardianLinks        GuardianLink[]
  /// Storage key for this person's photograph, or null.
  ///
  /// On User rather than on StudentProfile and StaffProfile separately,
  /// because a photograph is a fact about a person and every one of them is a
  /// User. It is never a URL: the key is resolved against per-school storage
  /// and served through an authorised route, so a child's photograph is never
  /// at a guessable public address.
  photoKey String?

  homeroomFor          Class[]        @relation("HomeroomTeacher")
  classMessages        ClassMessage[]  @relation("ClassMessageAuthor")
  parentMessages       ParentMessage[] @relation("ParentMessageAuthor")
  createdSchemesOfWork SchemeOfWork[]
  createdLessonPlans   LessonPlan[]
  createdQuizzes       Quiz[]
  attendanceTaken      AttendanceRegister[] @relation("AttendanceTakenBy")
  messagesReceived     Message[]            @relation("MessageRecipient")
  timetableEntries     TimetableEntry[]     @relation("TimetableTeacher")
  teachingAssignments  TeachingAssignment[] @relation("TeachingAssignmentTeacher")
  staffProfile         StaffProfile?
  tutorSessions        TutorSession[]       @relation("TutorSessionStartedBy")
  lessonResources      LessonResource[]     @relation("LessonResourceAddedBy")
  accessibilityProfile AccessibilityProfile?
  accessibilityEdits   AccessibilityProfile[] @relation("AccessibilityProfileUpdatedBy")
  assignmentsSet       Assignment[]           @relation("AssignmentSetBy")
  questionBankItems    QuestionBankItem[]     @relation("QuestionBankItemCreatedBy")
  examsCreated         Exam[]                 @relation("ExamCreatedBy")

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  ipAddress String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("refresh_tokens")
}

/// Named on a class page so a family knows who is in charge. Not a
/// permission — see StaffProfile.leadership.
enum SchoolLeadership {
  PRINCIPAL
  VICE_PRINCIPAL
  HEAD_TEACHER
}

/// One conversation per class, created the first time somebody opens it.
///
/// A class group and nothing else. There is no student-to-student channel in
/// this system, and that is a safeguarding decision rather than a missing
/// feature: a group their teacher sits in can be supervised, and a private
/// channel between two children cannot.
/// One conversation between a family and the school, about one child.
///
/// Keyed on the child rather than on a (parent, teacher) pair, and that is
/// the whole design: teachers change, both parents belong in the same thread,
/// and a private channel between one adult and one child's parent is the
/// arrangement safeguarding policy exists to prevent. See
/// parent-message-rules.ts.
///
/// The student is not a participant. A parent raising a worry about their
/// child is not writing to the child.
model ParentThread {
  id               String         @id @default(cuid())
  studentProfileId String         @unique
  studentProfile   StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)

  /// Denormalised so an inbox can be sorted without reading every message.
  lastMessageAt DateTime?
  lastSide      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages ParentMessage[]

  @@index([lastMessageAt])
  @@map("parent_threads")
}

model ParentMessage {
  id       String       @id @default(cuid())
  threadId String
  thread   ParentThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  authorUserId String
  author       User   @relation("ParentMessageAuthor", fields: [authorUserId], references: [id], onDelete: Cascade)
  /// Snapshotted: a thread must still read correctly after the teacher has
  /// left and the guardian link has been removed.
  authorName   String
  /// "FAMILY" or "SCHOOL". A plain string because this is history, and it
  /// outlives whoever wrote it.
  side         String

  body String

  /// Withdrawn, not erased: the other person saw it. Unlike a class message,
  /// staff cannot read the original back — this is two adults talking.
  deletedAt       DateTime?
  deletedByUserId String?

  createdAt DateTime @default(now())

  @@index([threadId, createdAt])
  @@map("parent_messages")
}

model ClassConversation {
  id      String @id @default(cuid())
  classId String @unique
  class   Class  @relation(fields: [classId], references: [id], onDelete: Cascade)

  /// Set by a teacher to stop students posting — during a lesson, or after
  /// something went wrong. Teachers can still write, so the room can be
  /// closed without going silent.
  lockedAt     DateTime?
  lockedById   String?
  lockedReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages ClassMessage[]

  @@map("class_conversations")
}

model ClassMessage {
  id             String            @id @default(cuid())
  conversationId String
  conversation   ClassConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  authorUserId String
  author       User   @relation("ClassMessageAuthor", fields: [authorUserId], references: [id], onDelete: Cascade)
  /// Snapshotted so a message still says who wrote it after they leave the
  /// school — the same reasoning as a payslip's staff name.
  authorName   String
  authorRole   String

  body String

  /// Soft delete, always. Removing a message must not remove it from
  /// moderation: "delete the evidence" is exactly the move this has to
  /// survive. Students see a gap, staff see the original text.
  deletedAt      DateTime?
  deletedByUserId String?
  deletedReason   String?

  createdAt DateTime @default(now())

  reports ClassMessageReport[]

  /// The query this table exists to serve: one conversation, newest last.
  @@index([conversationId, createdAt])
  /// Rate limiting asks "what has this person sent here recently".
  @@index([conversationId, authorUserId, createdAt])
  @@map("class_messages")
}

/// A child saying "this one is not ok".
///
/// Separate from deletion on purpose: reporting is something a student can
/// do, deleting is not, and a report that quietly deleted the message would
/// hand every class a way to silence anyone.
model ClassMessageReport {
  id        String       @id @default(cuid())
  messageId String
  message   ClassMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  reportedByUserId String
  reportedByName   String
  reason           String

  reviewedAt       DateTime?
  reviewedByUserId String?
  outcome          String?

  createdAt DateTime @default(now())

  /// One report per person per message: a second one adds nothing and lets a
  /// group bury a teacher in duplicates.
  @@unique([messageId, reportedByUserId])
  @@index([reviewedAt])
  @@map("class_message_reports")
}

model Class {
  id                String  @id @default(cuid())
  name              String
  gradeLevel        String?
  /// Plain string for this phase (e.g. "2026-2027") — a full AcademicYear/
  /// Term entity is a later-phase concern once curriculum scheduling needs it.
  academicYear      String
  homeroomTeacherId String?
  homeroomTeacher   User?   @relation("HomeroomTeacher", fields: [homeroomTeacherId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  enrollments         Enrollment[]
  conversation        ClassConversation?
  attendanceRegisters AttendanceRegister[]
  feeStructures       FeeStructure[]
  assessments         Assessment[]
  termResults         TermResult[]
  timetableEntries    TimetableEntry[]
  teachingAssignments TeachingAssignment[]
  assignments         Assignment[]
  exams               Exam[]

  @@index([academicYear])
  @@map("classes")
}

model StudentProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// School-issued admission/roll number — optional since not every school
  /// assigns one at creation time.
  studentCode String?   @unique
  dateOfBirth DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  enrollments       Enrollment[]
  guardianLinks     GuardianLink[]
  parentThread      ParentThread?
  attendanceRecords AttendanceRecord[]
  feeInvoices       FeeInvoice[]
  marks             Mark[]
  termResults       TermResult[]
  messages          Message[]
  tutorSessions     TutorSession[]
  submissions       Submission[]
  examAttempts      ExamAttempt[]

  @@map("student_profiles")
}

model Enrollment {
  id               String           @id @default(cuid())
  studentProfileId String
  studentProfile   StudentProfile   @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  classId          String
  class            Class            @relation(fields: [classId], references: [id], onDelete: Cascade)
  status           EnrollmentStatus @default(ACTIVE)
  startDate        DateTime         @default(now())
  endDate          DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Deliberately NOT a compound @@unique on (studentProfileId, classId): a
  /// student can withdraw and re-enrol later. Prisma's schema DSL has no
  /// partial-unique-index support to express "unique only while ACTIVE", so
  /// EnrollmentsService enforces "no second ACTIVE row for the same pair" at
  /// the service layer instead.
  @@index([studentProfileId])
  @@index([classId])
  @@map("enrollments")
}

model GuardianLink {
  id               String         @id @default(cuid())
  guardianUserId   String
  guardianUser     User           @relation(fields: [guardianUserId], references: [id], onDelete: Cascade)
  studentProfileId String
  studentProfile   StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  /// Free text ("Mother", "Legal Guardian", …) — an enum would just churn.
  relationship     String

  /// Per-family notification opt-out, defaulting to opted in.
  ///
  /// Held on the link rather than the guardian so a parent can mute one
  /// child's routine notifications without going silent on another's — the
  /// realistic case being a guardian who also works at the school.
  notifyByEmail Boolean @default(true)
  notifyBySms   Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([guardianUserId, studentProfileId])
  @@index([studentProfileId])
  @@map("guardian_links")
}

// ─────────────────────────── Per-school branding ───────────────────────────

/// How a school's console and login page present themselves.
///
/// Lazily created rather than seeded at provisioning, unlike
/// CurriculumSettings: every field has a sensible default, so a school that
/// never opens the branding page must render identically to one that did
/// not have the feature — and every school provisioned before this model
/// existed has to work without a backfill. The service treats "no row" and
/// "row with defaults" as the same thing (see branding.service.ts).
///
/// Lives in the tenant database, not the control database, because it is
/// the school's own data, edited by the school's own admin. The public
/// login-page endpoint reaches it by resolving the host to a school first
/// and then reading that school's database — the ordinary tenant path, one
/// step earlier than usual.
model BrandingSettings {
  id String @id @default(cuid())

  /// What the school calls itself, if that differs from the name on the
  /// platform's registry (which an admin cannot edit — it identifies the
  /// customer, not the brand).
  displayName String?
  tagline     String?

  /// Storage key, never a URL and never shown to a client: the public URL
  /// is built from the school's slug and the bare filename so that one
  /// school's key can't address another's file. See storage/storage.ts.
  logoKey String?

  /// Hex, normalised to six lowercase digits before it is stored — these
  /// land in CSS custom properties, and validation is what keeps a colour
  /// from being a stylesheet. Defaults are the console's existing blue and
  /// teal.
  primaryColor String @default("#1d4ed8")
  accentColor  String @default("#0f766e")

  updatedByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("branding_settings")
}

// ── AI Curriculum Engine — Phase 1: settings, subjects, schemes of work ──
// See PROGRESS.md for the phased scope: lesson plans, quizzes, exams,
// worksheets, and exports all follow this same shape in later phases.

enum CurriculumMode {
  MANUAL
  AI_AUTOMATIC
  HYBRID
}

/// Real singleton, one row per school — seeded at provisioning time
/// (ProvisioningService.seedSchoolAdmin), never lazily created. Mode gates
/// only whether the AI-generate endpoint is offered; manual create/edit is
/// always available regardless of mode (see PROGRESS.md for why).
model CurriculumSettings {
  id                 String         @id @default(cuid())
  mode               CurriculumMode @default(MANUAL)
  /// Free text fed straight into the AI prompt (e.g. "Nigeria", "United
  /// States") — relying on the model's own knowledge of that country's
  /// standards rather than a maintained standards database, which is its
  /// own later-phase concern if it's ever needed.
  country            String?
  curriculumStandard String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("curriculum_settings")
}

model Subject {
  id         String  @id @default(cuid())
  name       String
  /// Free text, same convention as Class.gradeLevel.
  gradeLevel String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  schemesOfWork SchemeOfWork[]
  assessments   Assessment[]
  subjectResults SubjectResult[]
  timetableEntries TimetableEntry[]
  teachingAssignments TeachingAssignment[]
  tutorSessions    TutorSession[]
  lessonResources  LessonResource[]
  assignments      Assignment[]
  questionBankItems QuestionBankItem[]
  exams             Exam[]

  @@unique([name, gradeLevel])
  @@map("subjects")
}

enum SchemeOfWorkStatus {
  DRAFT
  PUBLISHED
}

enum ContentSource {
  MANUAL
  AI_GENERATED
}

model SchemeOfWork {
  id           String             @id @default(cuid())
  subjectId    String
  subject      Subject            @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  academicYear String
  /// Free text ("Term 1", "Semester 1"...) — schools vary in how they divide the year.
  term         String
  status       SchemeOfWorkStatus @default(DRAFT)
  source       ContentSource
  /// `{ weeks: [{ weekNumber, topic, objectives: string[], activities: string[] }] }`
  /// — the same shape whether hand-written or AI-generated; validated at
  /// the service layer against the Gemini responseSchema, not a DB constraint.
  content      Json
  generatedAt  DateTime?
  createdById  String?
  createdBy    User?              @relation(fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lessonPlans   LessonPlan[]
  quizzes       Quiz[]
  tutorSessions TutorSession[]

  @@unique([subjectId, academicYear, term])
  @@map("schemes_of_work")
}

// ── AI Curriculum Engine — Phase 4: lesson plans ──
// Repeats the exact same shape as schemes of work: mode-gated AI generate,
// manual create/edit/publish always available, PUBLISHED-only read scoping
// for STUDENT/GUARDIAN. See PROGRESS.md.

enum LessonPlanStatus {
  DRAFT
  PUBLISHED
}

model LessonPlan {
  id             String           @id @default(cuid())
  schemeOfWorkId String
  schemeOfWork   SchemeOfWork     @relation(fields: [schemeOfWorkId], references: [id], onDelete: Cascade)
  /// Which week of the parent scheme of work this lesson plan expands into
  /// a full daily lesson — one lesson plan per week, same "one week = one
  /// lesson" simplification SchemeOfWork.content itself already makes.
  weekNumber     Int
  status         LessonPlanStatus @default(DRAFT)
  source         ContentSource
  /// `{ objectives: string[], materials: string[], introduction: string,
  /// developmentSteps: string[], conclusion: string, assessment: string,
  /// homework: string }` — built from the parent week's topic/objectives/
  /// activities when generated, editable afterward same as schemes of work.
  content     Json
  generatedAt DateTime?
  createdById String?
  createdBy   User?     @relation(fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([schemeOfWorkId, weekNumber])
  @@map("lesson_plans")
}

// ── AI Curriculum Engine — Phase 5: quizzes ──
// Same mode-gated generate / manual edit / publish shape as lesson plans,
// plus one thing no earlier content type had: the stored content contains
// answers that STUDENT/GUARDIAN viewers must never receive. That stripping
// happens at the service layer (see strip-answers.ts) — the DB deliberately
// keeps one source of truth rather than splitting the answer key into its
// own table, which would just drift.

enum QuizStatus {
  DRAFT
  PUBLISHED
}

model Quiz {
  id             String       @id @default(cuid())
  schemeOfWorkId String
  schemeOfWork   SchemeOfWork @relation(fields: [schemeOfWorkId], references: [id], onDelete: Cascade)
  /// Which week of the parent scheme this quiz assesses. Deliberately NOT
  /// unique with schemeOfWorkId: unlike a lesson plan, a week can have more
  /// than one quiz (a retest, an extension paper), so quizzes carry a title
  /// to tell them apart.
  weekNumber     Int
  title          String
  status         QuizStatus    @default(DRAFT)
  source         ContentSource
  /// `{ questions: [{ questionNumber, prompt, type, options: string[],
  /// correctAnswer, marks }] }`. `correctAnswer` is stripped before the
  /// response ever reaches a STUDENT or GUARDIAN — see QuizzesService.
  content     Json
  generatedAt DateTime?
  createdById String?
  createdBy   User?     @relation(fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schemeOfWorkId])
  @@map("quizzes")
}

// ── Attendance ───────────────────────────────────────────────────────
// A register is taken per class per day, optionally per session so a
// school running subject periods can mark more than once a day. Schools
// that only mark once a day leave `session` null.

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

model AttendanceRegister {
  id      String @id @default(cuid())
  classId String
  class   Class  @relation(fields: [classId], references: [id], onDelete: Cascade)
  /// Date only, normalised to UTC midnight by the service, so "the register
  /// for 3 August" cannot become two registers because of a clock offset.
  date    DateTime
  /// Empty string for schools that mark once a day; a period label
  /// otherwise. Deliberately NOT nullable: Postgres treats NULLs as
  /// distinct in a unique index, so a nullable `session` would silently
  /// defeat the @@unique below and allow two whole-day registers for the
  /// same class and date. Caught by a type error, not by review.
  session String @default("")

  takenById String?
  takenBy   User?    @relation("AttendanceTakenBy", fields: [takenById], references: [id])
  takenAt   DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  records AttendanceRecord[]

  /// One register per class, date and session. Two teachers opening the
  /// register at once must not produce two conflicting sets of marks.
  @@unique([classId, date, session])
  @@index([classId])
  @@map("attendance_registers")
}

model AttendanceRecord {
  id               String             @id @default(cuid())
  registerId       String
  register         AttendanceRegister @relation(fields: [registerId], references: [id], onDelete: Cascade)
  studentProfileId String
  studentProfile   StudentProfile     @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)

  status AttendanceStatus
  /// Free text for "left early", "medical appointment" and the like.
  note   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  amendments AttendanceAmendment[]

  @@unique([registerId, studentProfileId])
  @@index([studentProfileId])
  @@map("attendance_records")
}

/// Every change to an already-recorded mark. Attendance is a record of what
/// happened and is routinely used to justify decisions about a child, so a
/// mark must never be silently rewritten — corrections are legitimate, but
/// they have to be visible, attributed and explained.
model AttendanceAmendment {
  id       String           @id @default(cuid())
  recordId String
  record   AttendanceRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)

  fromStatus AttendanceStatus
  toStatus   AttendanceStatus
  reason     String

  /// Stored by value rather than as a foreign key, for the same reason as
  /// SchoolLifecycleEvent: deleting a departed teacher's account must not
  /// erase the history of the corrections they made.
  actorUserId String
  actorName   String

  createdAt DateTime @default(now())

  @@index([recordId])
  @@map("attendance_amendments")
}

// ── Per-school gateway settings ──
// Every school owns and configures its own communication and payment
// services; nothing here is shared platform-wide. Columns ending in
// `Encrypted` hold AES-256-GCM ciphertext produced by TenantSecretsService
// and must never be selected into an API response — the services return a
// masked hint instead. See PROGRESS.md.

enum SmtpEncryption {
  NONE
  TLS
  SSL
}

/// Singleton per school. Lazily created on first save, unlike
/// CurriculumSettings — a school with no email gateway is a normal state,
/// so there is nothing meaningful to seed at provisioning time.
model EmailGatewaySettings {
  id                String         @id @default(cuid())
  host              String?
  port              Int?
  username          String?
  passwordEncrypted String?
  encryption        SmtpEncryption @default(TLS)
  senderName        String?
  senderEmail       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("email_gateway_settings")
}

/// Provider-agnostic by design: schools pick their own SMS vendor, so the
/// vendor is free text and the call is driven by baseUrl + credentials
/// rather than a hardcoded per-provider integration.
model SmsGatewaySettings {
  id                 String  @id @default(cuid())
  providerName       String?
  baseUrl            String?
  apiKeyEncrypted    String?
  apiSecretEncrypted String?
  senderId           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("sms_gateway_settings")
}

model WhatsAppGatewaySettings {
  id                            String  @id @default(cuid())
  accessTokenEncrypted          String?
  phoneNumberId                 String?
  businessAccountId             String?
  webhookUrl                    String?
  webhookVerifyTokenEncrypted   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("whatsapp_gateway_settings")
}

/// `credentialsEncrypted` holds a provider-specific JSON blob (an FCM
/// service-account key, a VAPID pair, …) because the shape differs per
/// provider and pinning columns to one vendor would defeat the point.
model PushGatewaySettings {
  id                   String  @id @default(cuid())
  providerName         String?
  credentialsEncrypted String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("push_gateway_settings")
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  VOLUNTEER
}

/// The employment record behind a staff member's login.
///
/// Teachers were previously bare `User` rows, which left nowhere to record a
/// staff number, a job title or the bank details payroll needs. Separated
/// from `User` rather than bolted onto it because a login and an employment
/// record have different lifetimes: an account can be disabled while the
/// employment record must survive for payroll history.
model StaffProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// School-issued staff number. Optional, like `StudentProfile.studentCode`,
  /// since not every school assigns one — but it is the natural key that lets
  /// a staff spreadsheet be re-imported as an update rather than creating
  /// duplicate people. Unique with NULLs distinct, so any number of staff may
  /// have none.
  staffNumber String? @unique

  jobTitle       String?
  employmentType EmploymentType?
  startDate      DateTime?
  endDate        DateTime?

  /// Which part of the school this person belongs to — "Primary",
  /// "Secondary", "Islamiyyah", "Security", "Kitchen".
  ///
  /// Free text and distinct from jobTitle: a school has Primary teachers and
  /// Secondary teachers with the same job title, and turnover is read by
  /// section because that is where a gap has to be filled. An enum would need
  /// a migration every time a school opened a new wing.
  section String?

  /// How much to recover from this person's salary each month towards their
  /// own children's school fees.
  ///
  /// Zero means the arrangement is off, which is the default: a school must
  /// opt each member of staff in, because deducting fees from somebody's wages
  /// without their agreement is not something to do by accident.
  ///
  /// A cap rather than the full balance. A teacher whose children owe a whole
  /// term would otherwise see an entire month's pay disappear, and the point
  /// of the arrangement is to spread it.
  childFeeDeductionCents Int @default(0)

  /// The staff member's Retirement Savings Account PIN, printed on the
  /// schedule filed with the pension administrator. Free text: the format is
  /// the PFA's to define, not ours, and a school importing existing records
  /// must not have them rejected by a pattern we invented.
  ///
  /// Not encrypted, unlike the bank account number: a PIN identifies an
  /// account but cannot move money out of it, and it has to be printed on a
  /// schedule that leaves the building every month anyway.
  pensionPin String?

  /// "Degree", "NCE", "Diploma" — free text rather than an enum, because the
  /// list differs by country and by what a school chooses to record, and an
  /// enum would need a migration every time a school hired somebody with a
  /// qualification nobody had anticipated. Printed on the salary voucher.
  qualification String?
  /// One line the bursar writes against a person on the voucher — "on leave",
  /// "half month", "resigned 14th". Belongs to the person rather than to a
  /// single month's payslip, because it is usually a standing note.
  remark        String?

  /// Where this person sits in the school's leadership, if anywhere.
  ///
  /// Deliberately NOT a role. Roles decide what the software lets you do, and
  /// a principal is not granted extra powers by being named one — they are
  /// already a SCHOOL_ADMIN or a TEACHER. This is who a class page should
  /// name when a parent asks who is in charge, which is a fact about the
  /// school rather than a permission.
  leadership SchoolLeadership?

  bankName    String?
  /// Sort code, routing number, or the local equivalent. Not secret on its
  /// own — it identifies a bank, not an account.
  bankCode    String?
  accountName String?
  /// AES-256-GCM, same as the gateway secrets.
  ///
  /// Encrypted because a staff bank account number is the one field here that
  /// can be used to defraud someone directly, and masked everywhere by
  /// default: the API returns the last four digits unless an administrator
  /// explicitly asks for the full value. A payroll run needs the real number,
  /// so it can be retrieved — but that is a deliberate act, not a side effect
  /// of listing staff.
  accountNumberEncrypted String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  salaryComponents SalaryComponent[]
  payslips         Payslip[]
  loans            StaffLoan[]

  @@map("staff_profiles")
}

/// A record that someone looked at a staff member's full bank account
/// number.
///
/// Masked reads are not logged — they happen constantly and reveal nothing.
/// Only the deliberate act of unmasking is, because that is the act worth
/// being able to account for afterwards. Actor and subject are stored by
/// value for the same reason as attendance amendments: deleting an account
/// must not erase the record of what its owner did.
model BankDetailAccess {
  id String @id @default(cuid())

  staffProfileId String
  staffName      String

  actorUserId String
  actorName   String
  /// "payroll run", "bank rejected the payment", … supplied by the caller so
  /// the log says why, not merely that.
  reason String?

  createdAt DateTime @default(now())

  @@index([staffProfileId])
  @@index([createdAt])
  @@map("bank_detail_access")
}

// ── Homework and assignments ─────────────────────────────────────────────
// The daily loop the rest of the academic side was missing: a teacher sets
// work, students hand it in, it is marked, and the mark can flow into the
// grading already built rather than living in a second parallel gradebook.

enum AssignmentStatus {
  /// Being written. Invisible to students.
  DRAFT
  /// Visible to the class.
  SET
  /// Past its due date and closed to new submissions.
  CLOSED
}

model Assignment {
  id        String  @id @default(cuid())
  classId   String
  class     Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  title        String
  instructions String
  status       AssignmentStatus @default(DRAFT)

  /// When it is due. Nullable: plenty of homework is "before next lesson"
  /// rather than a timestamp, and inventing one would make work look late
  /// that nobody considered late.
  dueAt DateTime?

  /// Hundredths of a mark, as everywhere else marks are stored.
  maxScoreHundredths Int @default(10000)

  /// Optional link to the assessment this counts towards. When set, releasing
  /// a mark writes it through, so homework reaches the report card instead of
  /// being re-typed into a second gradebook. Nullable because most homework
  /// is formative and counts towards nothing.
  assessmentId String?
  assessment   Assessment? @relation(fields: [assessmentId], references: [id], onDelete: SetNull)

  setByUserId String?
  setByUser   User?   @relation("AssignmentSetBy", fields: [setByUserId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  submissions Submission[]

  @@index([classId, status])
  @@index([subjectId])
  @@map("assignments")
}

enum SubmissionStatus {
  /// Handed in, not yet looked at.
  SUBMITTED
  /// Marked, but the mark is not yet visible to the student.
  MARKED
  /// Marked and released to the student and their guardians.
  RELEASED
}

model Submission {
  id           String     @id @default(cuid())
  assignmentId String
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  studentProfileId String
  studentProfile   StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)

  /// What the student handed in. Text for now: file upload needs object
  /// storage, which is a phase of its own, and a text box is the difference
  /// between homework working and not existing.
  content String

  status      SubmissionStatus @default(SUBMITTED)
  submittedAt DateTime         @default(now())

  /// Decided once, when the work is handed in, and stored — not recomputed on
  /// read. A due date moved afterwards must not retroactively make a student
  /// late for something they handed in on time.
  isLate Boolean @default(false)

  scoreHundredths Int?
  feedback        String?
  markedAt        DateTime?
  markedByUserId  String?
  markedByName    String?
  releasedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// One submission per student per assignment. Handing in again replaces
  /// what is there rather than adding a second copy a teacher has to choose
  /// between.
  @@unique([assignmentId, studentProfileId])
  @@index([studentProfileId])
  @@map("submissions")
}

// ── Payroll ──────────────────────────────────────────────────────────────
// What the encrypted bank details on StaffProfile were always for.
//
// Money is an integer count of minor units throughout, as everywhere else in
// this schema. Two constraints carry most of the safety: one run per month,
// and one payslip per person per run. Paying somebody twice is a mistake a
// school notices at the bank, not in an audit log.
//
// The software never moves money. A run produces a file a bursar takes to
// the bank — the same line already drawn around the payment gateways.

enum PayComponentKind {
  EARNING
  DEDUCTION
}

enum PayComponentBasis {
  /// A flat amount in minor units.
  FIXED
  /// A percentage of basic pay, in hundredths of a percent (1250 = 12.5%).
  ///
  /// Of *basic*, never of gross: a deduction that is a percentage of gross,
  /// where gross depends on the deductions, has no fixed point.
  PERCENT_OF_BASIC
}

/// One line of a staff member's salary: "Basic", "Housing", "Pension", "Tax".
model SalaryComponent {
  id             String       @id @default(cuid())
  staffProfileId String
  staffProfile   StaffProfile @relation(fields: [staffProfileId], references: [id], onDelete: Cascade)

  label String
  kind  PayComponentKind
  basis PayComponentBasis @default(FIXED)

  /// Minor units when FIXED, hundredths of a percent when PERCENT_OF_BASIC.
  amount Int

  /// Exactly one component per staff member should be the basis percentages
  /// are taken from. Enforced in the service rather than the schema, since
  /// "at most one true per staffProfileId" needs a partial unique index that
  /// Prisma's DSL cannot express — same situation as Enrollment.
  isBasic Boolean @default(false)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([staffProfileId])
  @@map("salary_components")
}

enum PayrollRunStatus {
  /// Being prepared. Payslips are recomputed from current salaries on demand.
  DRAFT
  /// Signed off. Payslips are frozen and no longer track salary changes.
  APPROVED
  /// The bank has been instructed. Recorded, never performed by this software.
  PAID
}

model PayrollRun {
  id     String           @id @default(cuid())
  year   Int
  /// 1-12.
  month  Int
  status PayrollRunStatus @default(DRAFT)

  /// Free text: "March 2027 salaries", or a note about why it was late.
  notes String?

  approvedAt        DateTime?
  approvedByUserId  String?
  approvedByName    String?
  paidAt            DateTime?
  paidByUserId      String?
  paidByName        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payslips Payslip[]

  /// One payroll per month. The constraint that stops a school paying
  /// everybody twice because two administrators both pressed the button —
  /// the same reasoning as the one-invoice-per-subscription-period index.
  @@unique([year, month])
  @@map("payroll_runs")
}

enum StaffLoanKind {
  LOAN
  SALARY_ADVANCE
}

enum StaffLoanStatus {
  ACTIVE
  SETTLED
  WRITTEN_OFF
  CANCELLED
}

/// Money the school has lent a member of staff, recovered from pay.
model StaffLoan {
  id             String       @id @default(cuid())
  staffProfileId String
  staffProfile   StaffProfile @relation(fields: [staffProfileId], references: [id], onDelete: Cascade)

  kind StaffLoanKind @default(LOAN)
  /// Human-quotable, e.g. "LN-2026-0007". Unique so two clerks recording the
  /// same agreement twice collide instead of creating two debts.
  reference String @unique

  principalCents Int
  /// Maintained as repayments land, like FeeInvoice.paidCents, so a balance
  /// never requires summing the repayment table at read time. The repayments
  /// remain the record of truth if the two ever disagree.
  repaidCents           Int @default(0)
  monthlyDeductionCents Int @default(0)

  issuedOn DateTime        @default(now())
  status   StaffLoanStatus @default(ACTIVE)
  note     String?

  repayments StaffLoanRepayment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([staffProfileId])
  @@index([status])
  @@map("staff_loans")
}

/// One recovery against a loan. Append-only: a mistaken repayment is reversed
/// with a further record rather than edited away, because this is the school's
/// answer to "you already took that off my salary".
model StaffLoanRepayment {
  id     String    @id @default(cuid())
  loanId String
  loan   StaffLoan @relation(fields: [loanId], references: [id], onDelete: Cascade)

  /// Null for a repayment made in cash rather than through payroll.
  runId String?

  amountCents Int
  paidOn      DateTime @default(now())
  note        String?

  createdAt DateTime @default(now())

  /// THE guard against double recovery. Payroll gets re-run — a correction, a
  /// late starter, somebody clicking twice — and without this a second pass
  /// would quietly deduct the same instalment again. Enforced by the database
  /// rather than by a check in the service, because an invariant a caller can
  /// forget is not an invariant.
  ///
  /// NULL runIds are distinct in Postgres, so any number of cash repayments
  /// can coexist, which is what we want.
  @@unique([loanId, runId])
  @@index([loanId])
  @@map("staff_loan_repayments")
}

/// Where this school's pension contributions go, and on what terms.
///
/// A singleton per school, like CurriculumSettings. The provider and account
/// are printed at the top of every schedule, so they belong to the school
/// rather than to a payroll run.
model PensionSettings {
  id String @id @default(cuid())

  /// The Pension Fund Administrator, e.g. "FCMB Pensions Ltd".
  providerName String?
  /// Where the combined contribution is paid.
  remittanceBankName      String?
  remittanceAccountNumber String?

  /// The employer's share as a percentage OF THE EMPLOYEE'S contribution.
  ///
  /// Expressed this way because one number then covers both arrangements seen
  /// in practice: a school matching its staff pound for pound is 100, and
  /// Nigeria's statutory 10% employer against 8% employee is 125. A
  /// percentage of salary would need a definition of salary too, and schools
  /// disagree about what counts towards it.
  employerMatchPercent Int @default(100)

  /// Which deduction component carries the employee's contribution. Schools
  /// name it differently and the register has to find it.
  componentLabel String @default("Pension")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("pension_settings")
}

/// How this school wants its salary voucher laid out.
///
/// One row per school — the tenant database holds exactly one school, so this
/// is a singleton in the same way CurriculumSettings is. Kept out of the code
/// because schools genuinely disagree about voucher columns, and a school
/// admin must be able to change theirs from the portal without waiting for a
/// release.
model VoucherSettings {
  id String @id @default(cuid())

  /// Printed above the table, e.g. "GENERAL VOUCHER". The school's own name
  /// and the pay period are added around it automatically.
  title String @default("GENERAL VOUCHER")

  /// Rows between subtotals. A property of the paper the school prints on,
  /// which is why it is settings rather than a constant.
  rowsPerPage Int @default(16)

  /// `[{ key, label, source, money }]` — see voucher-layout.ts. Stored as JSON
  /// rather than as rows in a table because the order IS the meaning here: a
  /// voucher is a sequence of columns, and reordering rows in SQL to express
  /// that needs a position column that then has to be kept dense on every
  /// edit. A single document rewritten wholesale cannot get out of order.
  columns Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("voucher_settings")
}

model Payslip {
  id    String     @id @default(cuid())
  runId String
  run   PayrollRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  staffProfileId String
  staffProfile   StaffProfile @relation(fields: [staffProfileId], references: [id], onDelete: Cascade)

  /// Copied rather than joined, like the attendance amendment actor: a
  /// payslip is a financial record that must still read correctly after the
  /// person leaves and their account is removed.
  staffName   String
  staffNumber String?

  grossCents      Int
  deductionsCents Int
  netCents        Int

  /// Every component as it stood when the run was approved:
  /// `[{ label, kind, amountCents }]`. Snapshotted rather than recomputed so
  /// a pay rise in April cannot quietly rewrite March's payslip — the same
  /// choice as published term results.
  lines Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// One payslip per person per run.
  @@unique([runId, staffProfileId])
  @@index([staffProfileId])
  @@map("payslips")
}

/// The shape of a school's day, from which periods are derived.
///
/// Singleton per school, seeded at provisioning like the other settings. A
/// school states when the day starts and ends and how many lessons it wants
/// in it; the period boundaries are then computed rather than typed one at a
/// time, which is both faster and impossible to get inconsistent.
model TimetableSettings {
  id String @id @default(cuid())

  /// Minutes since midnight, as everywhere else in timetabling: a school day
  /// is a time-of-day that recurs, not an instant.
  dayStartMinute Int @default(480)
  dayEndMinute   Int @default(840)
  /// Teaching periods, not counting the break.
  periodsPerDay Int @default(8)

  /// A single break, placed after this many periods. Null means no break.
  /// One break covers the common case; a school wanting morning break and
  /// lunch can still edit the derived periods by hand afterwards.
  breakAfterPeriod  Int?
  breakLengthMinutes Int @default(30)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("timetable_settings")
}

/// "Ade teaches Mathematics to Grade 5A, four periods a week."
///
/// The missing input that made automatic generation impossible: a
/// TimetableEntry records where a lesson *ended up*, but nothing recorded
/// what the school actually needs scheduled. Generation reads these and
/// places them.
model TeachingAssignment {
  id      String @id @default(cuid())
  classId String
  class   Class  @relation(fields: [classId], references: [id], onDelete: Cascade)
  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  /// Nullable so a school can record what must be taught before it knows who
  /// will teach it. An unstaffed assignment still gets placed on the
  /// timetable — it simply cannot clash with anybody.
  teacherUserId String?
  teacher       User?   @relation("TeachingAssignmentTeacher", fields: [teacherUserId], references: [id], onDelete: SetNull)

  periodsPerWeek Int @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// One assignment per subject per class: "how many periods of Maths does
  /// Grade 5A get" has exactly one answer.
  @@unique([classId, subjectId])
  @@index([teacherUserId])
  @@map("teaching_assignments")
}

/// A slot in the school's day: "Period 1", "Break", "Period 2"…
///
/// Times are minutes since midnight rather than DateTime. A period is a
/// time-of-day that recurs, not an instant — storing it as a DateTime would
/// drag in a date nobody means and a timezone nobody set, and 08:30 would
/// start shifting when the clocks change.
model TimetablePeriod {
  id        String @id @default(cuid())
  label     String
  startMinute Int
  endMinute   Int
  /// Break and lunch occupy the day but hold no lesson.
  isTeaching Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  entries TimetableEntry[]

  @@map("timetable_periods")
}

/// Monday is 1, matching ISO-8601. Schools that teach on Saturday exist, so
/// the week is not assumed to be five days.
enum Weekday {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

/// One lesson: this class, this subject, this teacher, this slot.
///
/// Two unique constraints carry the scheduling invariants:
///
///   (classId, weekday, periodId)   — a class cannot be in two lessons at once
///   (teacherUserId, weekday, periodId) — a teacher cannot be in two rooms at once
///
/// The second relies on Postgres treating NULLs as distinct, and here that is
/// exactly right rather than a trap: an unassigned lesson has a null teacher,
/// and any number of classes may have an unstaffed slot at the same time.
/// The same NULL semantics that silently broke AttendanceRegister.session are
/// the reason this constraint can be written at all.
model TimetableEntry {
  id      String  @id @default(cuid())
  classId String
  class   Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  teacherUserId String?
  teacher       User?   @relation("TimetableTeacher", fields: [teacherUserId], references: [id], onDelete: SetNull)

  weekday  Weekday
  periodId String
  period   TimetablePeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)

  /// Free text: schools label rooms in their own way, and an enum would churn.
  room String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([classId, weekday, periodId])
  @@unique([teacherUserId, weekday, periodId])
  @@index([teacherUserId])
  @@index([periodId])
  @@map("timetable_entries")
}

enum MessageChannel {
  EMAIL
  SMS
  WHATSAPP
  PUSH
}

/// What happened that is worth telling a family about.
///
/// A closed set rather than free text: every event here has a template, a
/// recipient rule and a de-duplication key, and an unrecognised event would
/// have none of them.
enum MessageEvent {
  ATTENDANCE_ABSENT
  FEE_INVOICE_ISSUED
  FEE_INVOICE_OVERDUE
  RESULTS_PUBLISHED
  MANUAL
}

/// A school's wording for one event on one channel.
///
/// Bodies carry `{{placeholders}}` resolved against a typed context per
/// event. Rendering fails closed on an unknown placeholder — see
/// render-template.ts — because "Dear ," arriving at a parent is worse than
/// a message that did not go out.
model MessageTemplate {
  id      String         @id @default(cuid())
  event   MessageEvent
  channel MessageChannel
  /// Email only; ignored by SMS and WhatsApp.
  subject String?
  body    String
  enabled Boolean        @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages Message[]

  @@unique([event, channel])
  @@map("message_templates")
}

enum MessageStatus {
  QUEUED
  SENT
  FAILED
  /// The channel has no gateway configured, or the recipient has no address
  /// for it. Deliberately distinct from FAILED: nothing went wrong, there was
  /// simply nowhere to send. Collapsing the two would have schools chasing
  /// phantom errors.
  SKIPPED
}

/// One rendered message aimed at one recipient.
///
/// `dedupeKey` is what makes notification send-once. It encodes the event and
/// the thing it is about — "this student, this date, absent" — so re-saving a
/// register, re-raising invoices or republishing results cannot notify a
/// family twice. The unique index below is the guarantee; application
/// bookkeeping would race.
model Message {
  id         String           @id @default(cuid())
  event      MessageEvent
  channel    MessageChannel
  templateId String?
  template   MessageTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  /// The guardian or staff user this went to. Nullable so a message survives
  /// the deletion of the account it was addressed to — the record of what a
  /// school told a family must outlive the login.
  recipientUserId String?
  recipientUser   User?   @relation("MessageRecipient", fields: [recipientUserId], references: [id], onDelete: SetNull)
  /// Captured at send time, by value: an address that later changes must not
  /// rewrite where a message actually went.
  recipientName    String
  recipientAddress String

  /// Which child this concerns, for scoping and for the outbox view.
  studentProfileId String?
  studentProfile   StudentProfile? @relation(fields: [studentProfileId], references: [id], onDelete: SetNull)

  subject String?
  body    String

  status        MessageStatus @default(QUEUED)
  /// Why it was skipped or how it failed — shown to the school rather than
  /// buried in a log they cannot reach.
  statusReason String?
  /// The gateway's own id for the send, for reconciling against the provider.
  providerReference String?
  attempts          Int       @default(0)
  sentAt            DateTime?

  dedupeKey String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([dedupeKey, channel, recipientAddress])
  @@index([status])
  @@index([studentProfileId])
  @@index([event, createdAt])
  @@map("messages")
}

/// A school's grading scale. Seeded at provisioning with a sensible default
/// so no school is blocked from recording marks, but fully editable — grading
/// policy varies by country and system and is data here, never hardcoded.
model GradeScale {
  id        String @id @default(cuid())
  name      String
  isDefault Boolean @default(false)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  bands       GradeBand[]
  termResults TermResult[]

  @@map("grade_scales")
}

/// One band of a scale, e.g. A = 70–100.
///
/// Boundaries are whole percentage points and inclusive at both ends. Bands
/// must tile 0–100 with no gap and no overlap — a mark of 69.5 falling into
/// no band at all is how a report card ends up with a blank grade, so the
/// service validates coverage rather than trusting whoever typed the bands.
model GradeBand {
  id           String     @id @default(cuid())
  gradeScaleId String
  gradeScale   GradeScale @relation(fields: [gradeScaleId], references: [id], onDelete: Cascade)
  label        String
  minPercent   Int
  maxPercent   Int
  /// Optional: "Excellent", "Credit", "Fail" — printed on the report card.
  remark String?
  /// Optional grade point for schools that compute a GPA.
  gradePoint Int?

  @@index([gradeScaleId])
  @@map("grade_bands")
}

/// A piece of assessed work for one subject in one class in one term.
model Assessment {
  id        String  @id @default(cuid())
  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  classId   String
  class     Class   @relation(fields: [classId], references: [id], onDelete: Cascade)

  name         String
  academicYear String
  term         String
  /// Highest achievable raw score, in hundredths (see Mark.scoreHundredths).
  maxScoreHundredths Int
  /// Whole percentage points of the subject's term total. The weights of all
  /// assessments for one subject/class/term must sum to exactly 100 before
  /// results can be published — see grading-math.
  weightPercent Int

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  marks       Mark[]
  assignments Assignment[]
  exams       Exam[]

  @@unique([subjectId, classId, academicYear, term, name])
  @@index([classId, academicYear, term])
  @@map("assessments")
}

enum MarkStatus {
  RECORDED
  /// Sat the assessment and did not score — counts as zero.
  ABSENT
  /// Legitimately excused — excluded, and the remaining weights are
  /// renormalised so the student is judged only on what they sat.
  EXCUSED
}

model Mark {
  id               String         @id @default(cuid())
  assessmentId     String
  assessment       Assessment     @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  studentProfileId String
  studentProfile   StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)

  /// Hundredths of a mark: 1750 is 17.50 out of, say, 2000 (20.00).
  ///
  /// Integers for the same reason money is — teachers really do award half
  /// and quarter marks, and a term average assembled out of floats drifts.
  /// Null only when the status is ABSENT or EXCUSED, which is a state a
  /// score cannot express.
  scoreHundredths Int?
  status          MarkStatus @default(RECORDED)
  comment         String?

  recordedByUserId String?
  recordedByName   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([assessmentId, studentProfileId])
  @@index([studentProfileId])
  @@map("marks")
}

enum TermResultStatus {
  DRAFT
  PUBLISHED
}

/// A student's results for one class and term.
///
/// Publishing **snapshots** every computed figure. A school that later
/// retunes its grade scale, fixes a weight or corrects a mark must not
/// silently rewrite a report card a family has already been given — the same
/// rule as an invoice's line snapshot and a subscription's price.
model TermResult {
  id               String         @id @default(cuid())
  studentProfileId String
  studentProfile   StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  classId          String
  class            Class          @relation(fields: [classId], references: [id], onDelete: Cascade)
  academicYear     String
  term             String

  status TermResultStatus @default(DRAFT)
  /// Which scale produced the snapshotted grades, kept for provenance even
  /// though the labels below are already frozen.
  gradeScaleId String?
  gradeScale   GradeScale? @relation(fields: [gradeScaleId], references: [id], onDelete: SetNull)

  /// Overall percentage across subjects, in hundredths of a percent:
  /// 8567 is 85.67%.
  overallPercentHundredths Int?
  publishedAt              DateTime?
  publishedByUserId        String?
  publishedByName          String?
  comment                  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subjects SubjectResult[]

  @@unique([studentProfileId, classId, academicYear, term])
  @@index([classId, academicYear, term])
  @@map("term_results")
}

model SubjectResult {
  id           String     @id @default(cuid())
  termResultId String
  termResult   TermResult @relation(fields: [termResultId], references: [id], onDelete: Cascade)
  subjectId    String
  subject      Subject    @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  /// Hundredths of a percent, as above. Frozen at publication.
  percentHundredths Int
  /// The band label and remark as they read at publication — stored by value
  /// so editing the scale afterwards cannot rewrite an issued report card.
  gradeLabel  String
  gradeRemark String?
  gradePoint  Int?
  comment     String?

  @@unique([termResultId, subjectId])
  @@index([subjectId])
  @@map("subject_results")
}

/// Singleton per school, seeded at provisioning like CurriculumSettings.
///
/// `invoiceCounter` lives here rather than being derived from `count()` so a
/// number can be claimed inside the same transaction as the insert that uses
/// it. Counting rows outside the transaction hands two simultaneous requests
/// the same invoice number — the lesson already paid for in platform billing.
model FinanceSettings {
  id String @id @default(cuid())
  /// ISO 4217. Every amount in this school's finance tables is in this
  /// currency's minor units; there is deliberately no per-invoice currency,
  /// because mixed-currency arithmetic across a school's ledger is a
  /// different feature, not a free one.
  currency       String @default("NGN")
  invoiceCounter Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("finance_settings")
}

/// What a term costs — the template invoices are generated from.
model FeeStructure {
  id           String  @id @default(cuid())
  name         String
  academicYear String
  term         String
  /// Null means school-wide. A structure tied to a class only invoices the
  /// students enrolled in it.
  classId String?
  class   Class?  @relation(fields: [classId], references: [id], onDelete: SetNull)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  items    FeeItem[]
  invoices FeeInvoice[]

  @@unique([name, academicYear, term])
  @@index([academicYear])
  @@map("fee_structures")
}

model FeeItem {
  id             String       @id @default(cuid())
  feeStructureId String
  feeStructure   FeeStructure @relation(fields: [feeStructureId], references: [id], onDelete: Cascade)
  label          String
  /// Integer minor units. Never a float: an invoice whose lines don't sum to
  /// its total is a wrong invoice, not a rounding curiosity.
  amountCents Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([feeStructureId])
  @@map("fee_items")
}

enum FeeInvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  VOID
}

/// What one student owes.
model FeeInvoice {
  id               String         @id @default(cuid())
  invoiceNumber    String         @unique
  studentProfileId String
  studentProfile   StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  /// Null for a one-off invoice raised by hand (a replacement textbook, a
  /// trip). See the unique constraint below — the null is load-bearing.
  feeStructureId String?
  feeStructure   FeeStructure? @relation(fields: [feeStructureId], references: [id], onDelete: SetNull)

  academicYear String
  term         String
  currency     String
  /// Both integer minor units. `paidCents` is maintained as payments land so
  /// a balance never requires summing the payment table at read time.
  totalCents Int
  paidCents  Int              @default(0)
  status     FeeInvoiceStatus @default(DRAFT)
  dueDate    DateTime?
  issuedAt   DateTime?
  voidedAt   DateTime?
  note       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lines    FeeInvoiceLine[]
  payments FeePayment[]

  /// Generating a class's invoices twice must not charge a family twice.
  ///
  /// This relies on Postgres treating NULLs as *distinct* in a unique index,
  /// and here that behaviour is exactly what's wanted: structure-generated
  /// invoices are held to one per student per structure, while ad-hoc
  /// invoices (feeStructureId null) stay unlimited. Note this is the same
  /// rule that silently broke AttendanceRegister.session — distinct NULLs are
  /// a tool when the nulls mean "not part of this rule" and a trap when they
  /// mean "no value yet".
  @@unique([studentProfileId, feeStructureId])
  @@index([studentProfileId])
  @@index([status])
  @@map("fee_invoices")
}

model FeeInvoiceLine {
  id          String     @id @default(cuid())
  invoiceId   String
  invoice     FeeInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  label       String
  amountCents Int

  @@index([invoiceId])
  @@map("fee_invoice_lines")
}

enum FeePaymentMethod {
  CASH
  BANK_TRANSFER
  CARD
  MOBILE_MONEY
  GATEWAY
  OTHER
}

/// What actually came in. Append-only: a mistaken payment is reversed with a
/// further record, never edited away, because this is the school's answer to
/// "we already paid".
model FeePayment {
  id          String           @id @default(cuid())
  invoiceId   String
  invoice     FeeInvoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amountCents Int
  method      FeePaymentMethod
  /// Bank/gateway reference. Null for cash, which is why the unique index
  /// below tolerates many nulls but only one of any given reference.
  reference  String?
  receivedAt DateTime @default(now())
  note       String?

  /// Stored by value rather than as a foreign key, for the same reason as
  /// AttendanceAmendment and SchoolLifecycleEvent: deleting a departed
  /// bursar's account must not erase who took the money.
  recordedByUserId String
  recordedByName   String

  createdAt DateTime @default(now())

  /// A replayed gateway webhook must never credit a family twice.
  @@unique([invoiceId, reference])
  @@index([invoiceId])
  @@map("fee_payments")
}

enum PaymentProvider {
  PAYSTACK
  FLUTTERWAVE
  STRIPE
}

/// One row per provider per school, so a school can configure several and
/// enable whichever it wants.
model PaymentGatewaySettings {
  id                     String          @id @default(cuid())
  provider               PaymentProvider @unique
  publicKey              String?
  secretKeyEncrypted     String?
  webhookSecretEncrypted String?
  currency               String?
  enabled                Boolean         @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("payment_gateway_settings")
}

// ── AI Teacher ───────────────────────────────────────────────────────────
// A tutoring conversation grounded in the school's own curriculum, not
// open-ended chat: a session is anchored to a subject and a topic, and
// optionally to one week of a published scheme of work, so the AI teaches
// what the school is actually teaching.
//
// Every turn is stored. That is not for resuming a conversation (though it
// allows it) — it is because a child is on the other side of it, and a
// school or a parent must be able to read exactly what the AI said. An
// unlogged tutor is not shippable to minors.

enum TutorSessionStatus {
  ACTIVE
  /// Put down mid-class. Distinct from ENDED because the student intends to
  /// come back, and `position` is what they come back to.
  PAUSED
  ENDED
}

enum TutorSessionMode {
  /// The student drives: they ask, the tutor answers.
  ASK
  /// The tutor drives: a generated course is taught a step at a time, and
  /// the student can interrupt with questions without losing their place.
  AUTO
}

enum TutorTurnRole {
  STUDENT
  TUTOR
}

model TutorSession {
  id String @id @default(cuid())

  /// Whose session this is. A staff member trying the tutor out has no
  /// student profile, hence nullable — see `startedByUserId`, which is
  /// always set and is what authorisation is actually checked against.
  studentProfileId String?
  studentProfile   StudentProfile? @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)

  startedByUserId String
  startedByUser   User   @relation("TutorSessionStartedBy", fields: [startedByUserId], references: [id])

  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  /// Optional anchor to a specific week of a scheme of work. When set, that
  /// week's objectives go into the prompt, which is the difference between
  /// "explain fractions" and "explain fractions the way this class is being
  /// taught them this term".
  schemeOfWorkId String?
  schemeOfWork   SchemeOfWork? @relation(fields: [schemeOfWorkId], references: [id], onDelete: SetNull)
  weekNumber     Int?

  /// What the student is trying to learn, in their own words.
  topic  String
  status TutorSessionStatus @default(ACTIVE)
  mode   TutorSessionMode   @default(ASK)

  /// The course for an AUTO class:
  /// `{ lessons: [{ title, objectives: string[] }] }`, generated once when
  /// the class starts. Kept rather than re-derived so a student who comes
  /// back next week gets the same course they started, not a fresh one the
  /// model happened to invent that day.
  outline Json?

  /// How many lessons of `outline` have been taught. This is the whole
  /// point of pausing: coming back means resuming here, not restarting.
  /// Advanced only after a lesson's turn is safely stored, so an
  /// interrupted request re-teaches a step rather than skipping it — the
  /// same reasoning as reserving a turn before calling the provider.
  position Int @default(0)

  startedAt DateTime  @default(now())
  endedAt   DateTime?
  updatedAt DateTime  @updatedAt

  turns TutorTurn[]

  @@index([studentProfileId])
  @@index([startedByUserId])
  @@map("tutor_sessions")
}

model TutorTurn {
  id        String       @id @default(cuid())
  sessionId String
  session   TutorSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  /// Position in the conversation, 1-based. The unique constraint below is
  /// what makes a double-tapped Send harmless: the second insert collides
  /// rather than producing a second turn 4 and a transcript whose order
  /// depends on createdAt tie-breaking.
  sequence Int
  role     TutorTurnRole
  content  String

  /// An optional diagram for this turn, as SVG.
  ///
  /// SVG rather than a generated bitmap: a text model draws a labelled
  /// number line or fraction bar well, it costs nothing beyond the turn
  /// already being paid for, and it stays sharp on a phone. Stored only
  /// after passing sanitize-svg.ts — this is markup written by a model and
  /// rendered in a child's browser, so it is untrusted input.
  diagram String?

  /// What the diagram shows, in words.
  ///
  /// Lifted from the diagram's own `<title>`/`<desc>` when it has them. A
  /// picture with no text alternative is simply absent for a student using a
  /// screen reader, which is the difference between a lesson they can take
  /// and one they cannot.
  diagramAlt String?

  /// Which lesson of the course this turn belongs to, for AUTO classes.
  /// Null for questions, which is how a question asked mid-class is
  /// distinguished from the teaching itself.
  lessonIndex Int?

  createdAt DateTime @default(now())

  @@unique([sessionId, sequence])
  @@index([sessionId])
  @@map("tutor_turns")
}

// ── Accessibility ────────────────────────────────────────────────────────
// A student who cannot read small text, cannot see a diagram, or needs an
// idea broken into smaller pieces is not a student who should be taught
// differently on request — they should be taught that way by default, every
// time, without having to ask again.
//
// One line governs this whole area: the profile shapes *how* a lesson is
// taught, and the note recording *why* never leaves this database. Neutral
// instructions go to the AI provider; a child's diagnosis does not.

enum ReadingSupport {
  NONE
  /// Short sentences, everyday words, new terms defined on first use.
  SIMPLIFIED
  /// One idea at a time, with a check for understanding before moving on.
  STEP_BY_STEP
}

model AccessibilityProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Display preferences, applied across the whole portal rather than only
  /// in the AI Teacher: a student who needs larger text needs it on the
  /// timetable too.
  largeText    Boolean @default(false)
  highContrast Boolean @default(false)
  dyslexiaFont Boolean @default(false)
  reduceMotion Boolean @default(false)

  readingSupport ReadingSupport @default(NONE)

  /// Describe every diagram in words as well as drawing it. A screen-reader
  /// user needs this; a sighted student loses nothing by having it.
  describeVisuals Boolean @default(false)

  /// Withhold demonstrations that are not known to be captioned, rather than
  /// offering a video this student cannot follow.
  requireCaptions Boolean @default(false)

  /// Staff-only, both to read and to write, and never sent to the AI
  /// provider. This is where "uses a screen reader" or a diagnosis would be
  /// written down, which makes it the most sensitive column in the tenant
  /// schema — see accessibility.service.ts.
  notes String?

  updatedByUserId String?
  updatedByUser   User?   @relation("AccessibilityProfileUpdatedBy", fields: [updatedByUserId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("accessibility_profiles")
}

enum LessonResourceKind {
  VIDEO
  DOCUMENT
  LINK
}

/// A demonstration a person made, offered to a student mid-class.
///
/// Added by staff, never by the AI. A model asked for "a good video about
/// fractions" will confidently invent a URL, and the failure mode of that is
/// a child sent somewhere nobody vetted. So the school curates these and the
/// class merely offers whichever ones match the lesson — the student chooses
/// whether to watch, and the class waits.
model LessonResource {
  id        String             @id @default(cuid())
  subjectId String
  subject   Subject            @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  kind      LessonResourceKind @default(VIDEO)
  title     String
  url       String
  /// Free-text words matched loosely against a lesson title, so one
  /// demonstration can serve several lessons without being pinned to one.
  /// Deliberately not a foreign key to a lesson: the course is generated and
  /// its lessons have no stable ids to point at.
  keywords  String?

  /// Whether this demonstration is captioned.
  ///
  /// Defaults to false and must be asserted by the person adding it, because
  /// the honest default for "we do not know" is "do not offer this to a
  /// student who needs captions".
  hasCaptions Boolean @default(false)

  addedByUserId String?
  addedByUser   User?   @relation("LessonResourceAddedBy", fields: [addedByUserId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([subjectId])
  @@map("lesson_resources")
}

// ── Examinations and CBT ─────────────────────────────────────────────
// A Quiz (above) is a teaching artefact: a paper a teacher prints or
// walks a class through. An Exam is a paper a student *sits* on screen,
// against a clock, marked by the machine where the machine can be
// trusted and by a human where it cannot.

enum QuestionType {
  SINGLE_CHOICE
  MULTI_CHOICE
  TRUE_FALSE
  SHORT_ANSWER
  /// Never auto-marked. Present so a paper can mix objective and written
  /// questions instead of forcing a school to run two systems.
  ESSAY
}

enum ExamStatus {
  DRAFT
  /// Visible to the class and sittable inside its window.
  PUBLISHED
  /// No new attempts. Existing in-progress attempts are still allowed to
  /// finish — closing a paper must not destroy work in front of a child.
  CLOSED
}

enum ExamAttemptStatus {
  IN_PROGRESS
  SUBMITTED
  MARKED
  RELEASED
}

/// A reusable question. Editing or deleting one never changes a paper that
/// has already been built from it — see ExamQuestion.
model QuestionBankItem {
  id         String  @id @default(cuid())
  subjectId  String
  subject    Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  /// Free text, same convention as Class.gradeLevel and Subject.gradeLevel.
  gradeLevel String?
  topic      String?

  type   QuestionType
  prompt String
  /// `[{ key: "A", text: "..." }]` for the choice types; `[]` otherwise.
  options Json
  /// Choice types: the correct keys, e.g. `["A"]` or `["A", "C"]`.
  /// SHORT_ANSWER: every accepted spelling, e.g. `["4", "four"]`.
  /// ESSAY: `[]` — there is no key, and pretending there is one would
  /// invite the marker to auto-mark it.
  answer Json
  /// Hundredths of a mark, like Mark.scoreHundredths — teachers award
  /// half marks and a total assembled out of floats drifts.
  marksHundredths Int           @default(100)
  source          ContentSource @default(MANUAL)

  createdById String?
  createdBy   User?   @relation("QuestionBankItemCreatedBy", fields: [createdById], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  examQuestions ExamQuestion[]

  @@index([subjectId, gradeLevel])
  @@map("question_bank_items")
}

model Exam {
  id        String  @id @default(cuid())
  classId   String
  class     Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  title        String
  instructions String?
  academicYear String
  term         String

  /// Minutes from the moment a student starts. Their own deadline is
  /// computed once at that point and stored on the attempt, so this
  /// changing afterwards cannot move a clock already running.
  durationMinutes Int
  /// The window the paper may be started in. Null means no bound on that
  /// side — a take-anytime paper is legitimate.
  opensAt  DateTime?
  closesAt DateTime?

  /// Per-student question order, seeded on the attempt so it is stable
  /// across a refresh but different between neighbours.
  shuffleQuestions Boolean @default(true)

  status ExamStatus @default(DRAFT)

  /// Optional link into the gradebook, same shape as Assignment: most
  /// exams count towards a term result, but a mock or a practice paper
  /// does not, and inventing a gradebook entry for one would be wrong.
  assessmentId String?
  assessment   Assessment? @relation(fields: [assessmentId], references: [id])

  createdById String?
  createdBy   User?   @relation("ExamCreatedBy", fields: [createdById], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  questions ExamQuestion[]
  attempts  ExamAttempt[]

  @@index([classId, status])
  @@index([subjectId, academicYear, term])
  @@map("exams")
}

/// A question **as it appeared on this paper**, copied out of the bank when
/// the exam was built.
///
/// The same snapshot rule as a published TermResult and a Payslip: a
/// student sat a specific paper, and a teacher correcting a typo in the
/// bank next term must not silently change the questions that student
/// answered, or the marks they were given for them. `sourceItem` is kept
/// only so a teacher can trace where it came from, and is SetNull on
/// delete — removing a question from the bank cannot delete evidence.
model ExamQuestion {
  id     String @id @default(cuid())
  examId String
  exam   Exam   @relation(fields: [examId], references: [id], onDelete: Cascade)

  orderIndex   Int
  sourceItemId String?
  sourceItem   QuestionBankItem? @relation(fields: [sourceItemId], references: [id], onDelete: SetNull)

  type            QuestionType
  prompt          String
  options         Json
  answer          Json
  marksHundredths Int

  answers ExamAnswer[]

  @@unique([examId, orderIndex])
  @@map("exam_questions")
}

model ExamAttempt {
  id               String         @id @default(cuid())
  examId           String
  exam             Exam           @relation(fields: [examId], references: [id], onDelete: Cascade)
  studentProfileId String
  studentProfile   StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)

  status    ExamAttemptStatus @default(IN_PROGRESS)
  startedAt DateTime          @default(now())
  /// Computed once, at start, and stored. A duration edited mid-sitting
  /// must not shorten the clock of a student already writing.
  expiresAt   DateTime
  submittedAt DateTime?
  /// True when the paper was submitted by the deadline passing rather than
  /// by the student. Recorded because it is the honest description of what
  /// happened, and a teacher looking at a short paper deserves to know.
  autoSubmitted Boolean @default(false)

  /// Seeds this student's question order. Stored so a refresh, or a
  /// resumed attempt on another device, shows the same paper.
  shuffleSeed Int

  autoScoreHundredths   Int?
  manualScoreHundredths Int?
  totalScoreHundredths  Int?
  /// Set when any answer could not be marked by machine. The paper is not
  /// finished until a human has looked at those.
  needsReview Boolean @default(false)

  markedAt       DateTime?
  markedByUserId String?
  markedByName   String?
  /// Marks reach the student only when a teacher releases them, exactly as
  /// with homework.
  releasedAt DateTime?

  answers ExamAnswer[]

  @@unique([examId, studentProfileId])
  @@index([studentProfileId])
  @@map("exam_attempts")
}

model ExamAnswer {
  id             String       @id @default(cuid())
  attemptId      String
  attempt        ExamAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  examQuestionId String
  examQuestion   ExamQuestion @relation(fields: [examQuestionId], references: [id], onDelete: Cascade)

  /// Choice types: the chosen keys, `["A"]`. Written types: `["the text"]`.
  /// One shape for every type so the marker has no special cases.
  response Json

  awardedHundredths Int?
  /// Whether the machine awarded this, as opposed to a person. Kept so a
  /// student querying a mark can be told which it was.
  autoMarked  Boolean @default(false)
  needsReview Boolean @default(false)
  feedback    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([attemptId, examQuestionId])
  @@map("exam_answers")
}
