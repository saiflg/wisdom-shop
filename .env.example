# ── App ──────────────────────────────────────────────────────────────
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
# The separate EMS app (apps/ems) — currently a "coming soon" page. Read by
# the web app's nav link, and by ems itself to link back to the shop.
EMS_URL=http://localhost:3001
# apps/ems's own API. Host-side default here; docker-compose overrides it to
# the in-network service name (http://ems-api:4001) for the ems container.
EMS_API_URL=http://localhost:4001

# ── Database (Postgres via Prisma) ──────────────────────────────────
DATABASE_URL=postgresql://wisdom:wisdom@localhost:5432/wisdom_shop?schema=public

# ── apps/ems-api: control-plane database (School registry, platform ops) ──
CONTROL_DATABASE_URL=postgresql://wisdom:wisdom@localhost:5432/wisdom_ems_control?schema=public
# CREATEDB-privileged credentials, used ONLY by ProvisioningService to run
# CREATE DATABASE for a newly onboarded school — never for ordinary queries.
POSTGRES_ADMIN_URL=postgresql://wisdom:wisdom@localhost:5432/postgres
# Building blocks for per-school connection strings (one database per
# school, all on this same Postgres server — see PROGRESS.md).
TENANT_DB_HOST=localhost
TENANT_DB_PORT=5432
TENANT_DB_USER=wisdom
TENANT_DB_PASSWORD=wisdom

# ── apps/ems-api: auth ────────────────────────────────────────────────
# Deliberately NOT named JWT_ACCESS_SECRET/JWT_REFRESH_SECRET — this file is
# shared by every service via env_file, so reusing the shop's own key names
# here would hand both apps the identical secret, making a token from one
# valid on the other. Every ems-api secret below has its own distinct name
# for exactly that reason.
EMS_JWT_ACCESS_SECRET=changeme_ems_access_secret_min_32_chars___
EMS_JWT_REFRESH_SECRET=changeme_ems_refresh_secret_min_32_chars__

# Encrypts per-school gateway credentials (SMTP passwords, provider API
# secrets) at rest. Rotating this makes every stored secret unreadable —
# schools then see their gateways as unconfigured and must re-enter them.
EMS_SETTINGS_ENCRYPTION_KEY=changeme_ems_settings_encryption_min_32_c
PLATFORM_JWT_ACCESS_SECRET=changeme_ems_platform_access_min_32_chars_
PLATFORM_JWT_REFRESH_SECRET=changeme_ems_platform_refresh_min_32_char
SEED_PLATFORM_ADMIN_EMAIL=platform-admin@wisdomcampus.example
SEED_PLATFORM_ADMIN_PASSWORD=ChangeMe123!SuperSecret

# ── apps/ems-api: AI curriculum generation (Google Gemini) ──────────
# From Google AI Studio. Left blank on purpose — generation returns 503
# ("not configured") until this is set, same as the shop's own payment
# providers. Not needed for anything else in apps/ems-api to work.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ── Redis (cache, BullMQ) ───────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Search (Meilisearch) ────────────────────────────────────────────
MEILI_HOST=http://localhost:7700
MEILI_MASTER_KEY=changeme_dev_master_key

# ── Auth (JWT) ───────────────────────────────────────────────────────
JWT_ACCESS_SECRET=changeme_access_secret_min_32_chars_______
JWT_REFRESH_SECRET=changeme_refresh_secret_min_32_chars______
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_DOMAIN=
TWO_FACTOR_APP_NAME="Wisdom Shop"
TWO_FACTOR_ENCRYPTION_KEY=changeme_2fa_encryption_key_min_32_chars__

# ── Seed data (first Super Admin — run `pnpm prisma:seed`) ─────────
SEED_SUPER_ADMIN_EMAIL=superadmin@wisdomshop.example
SEED_SUPER_ADMIN_PASSWORD=ChangeMe123!SuperSecret

# ── Order pricing ────────────────────────────────────────────────────
# Only a flat shipping rate is implemented (see apps/api/src/orders/pricing.ts).
# Both default to 0 so nothing is charged unless you set it deliberately.
SHIPPING_FLAT_CENTS=0
TAX_PERCENT=0

# ── Educational Management System handoff ───────────────────────────
# Wisdom Shop redirects here after a School Setup purchase, with a
# short-lived signed token (see EmsHandoffService) proving the purchase.
# Points at apps/ems's own /onboarding page, which verifies the token
# against apps/ems-api (see onboarding/edu-handoff-token.ts there).
EDU_SETUP_REDIRECT_URL=http://localhost:3001/onboarding
# Shared with apps/ems-api on purpose — see that app's own env.validation.ts
# comment on this one exception to "every cross-app secret must be distinct".
EDU_SETUP_SIGNING_SECRET=changeme_edu_setup_secret_min_32_chars___

# ── Object storage (S3 / Cloudflare R2 compatible) ──────────────────
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_BUCKET=wisdom-shop-dev
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# ── Payments ─────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYSTACK_SECRET_KEY=
FLUTTERWAVE_SECRET_KEY=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# ── Notifications ────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Wisdom Shop <no-reply@wisdomshop.example>"
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
WHATSAPP_API_TOKEN=

# ── Monitoring ───────────────────────────────────────────────────────
SENTRY_DSN=

# --- Rate limiting -----------------------------------------------------------
# Global bucket, applied to every route.
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_LIMIT=100
# Strict bucket, applied only to routes marked @StrictRateLimit(): sign-in,
# registration, password reset, email re-verification. Twenty attempts per
# fifteen minutes per IP. Lower this if the API is not behind a shared NAT.
AUTH_RATE_LIMIT_TTL_MS=900000
AUTH_RATE_LIMIT_LIMIT=20

# --- Store -------------------------------------------------------------------
# Also editable at runtime in Admin → Settings. A value saved there takes
# precedence over these; these are the bootstrap defaults.
STORE_NAME=Wisdom Shop
STORE_SUPPORT_EMAIL=
STORE_SUPPORT_PHONE=

# How long a rotated refresh token may be replayed before it is treated as
# theft rather than as two browser tabs racing. Also requires the same client
# and that the chain has not moved on — see src/auth/refresh-race.ts.
# Set to 0 for strict detection, at the cost of signing users out when they
# open two tabs at once.
REFRESH_REUSE_GRACE_MS=15000

# --- File storage ------------------------------------------------------------
# Where uploaded product images and downloadable files are written. Relative
# paths resolve from the API's working directory.
#
# Local disk is a SINGLE-NODE story: with more than one API replica each gets
# its own directory, and a file uploaded to one is missing from the others.
# Mount a shared volume, or replace the driver in src/storage/storage.service.ts
# with an S3/R2 one — nothing outside that file needs to change.
STORAGE_ROOT=.storage
MAX_UPLOAD_MB=25

# --- Search ------------------------------------------------------------------
# Both must be set for indexing to run. With either missing — or with
# Meilisearch simply unreachable — the shop falls back to database matching,
# which works but has no typo tolerance or relevance ranking.
MEILI_HOST=http://localhost:7700
MEILI_MASTER_KEY=

# Recurring billing. Off by default: an accidental cycle run costs a
# customer money, so opting in is explicit. Correctness does not depend
# on this firing exactly once - a unique index prevents double-billing.
BILLING_CYCLE_ENABLED=false
BILLING_CYCLE_INTERVAL_MS=3600000
